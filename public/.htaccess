Options -MultiViews
RewriteEngine On

# Si el archivo o carpeta física existe (ej. un CSS o imagen), lo sirve directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Si no existe, envía toda la URL al index.php a través del parámetro 'route'
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]